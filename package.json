  "description": "Clar1ty Studio - Professional image upscaling with N3uralia engine",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
