    "test:huggingface:prod": "TEST_URL=https://clarity-upscaler.vercel.app node scripts/test-huggingface.js",
    "test:api": "node --experimental-strip-types --test __tests__/api/*.test.ts",
    "test:lib": "node --experimental-strip-types --test __tests__/lib/*.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
