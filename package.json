    "autoprefixer": "latest",
    "framer-motion": "latest",
    "lucide-react": "^1.26.0",
    "next": "latest",
    "onnxruntime-web": "^1.22.0",
    "postcss": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "0.34.5",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "^5.9.3"
